---
import Nav from '../ui/Nav.astro';
import Arrow from '../ui/Arrow.astro';
import { site } from '../../lib/site';
---

<header class="hero">
  <div class="hero__top">
    <div class="hero__header">
      <h1 class="hero__name">{site.name}</h1>
      <p class="hero__role">{site.role}</p>
    </div>
    <Nav />
  </div>

  <div class="hero__canvas" role="img" aria-label="Interactive background pattern">
    <canvas id="bg-canvas" aria-hidden="true"></canvas>
  </div>

  <section id="about" class="hero__about" aria-labelledby="about-heading">
    <h2 id="about-heading" class="section-title">About</h2>
    <p class="body-text">I'm Mattia, a multimedia designer. Big on sci-fi, videogames, and a storyteller at heart, I try to blend all this into my design work. To me, design is about striking a balance: an understanding of the problem, pushing creative boundaries, and delivering more than just a solution.</p>
  </section>

  <div class="hero__scroll" aria-hidden="true">
    <span class="label">see more</span>
    <Arrow direction="down" />
  </div>
</header>

<script>
  import '../../scripts/morpho-ascii.js';

  const SCROLL_HIDE_OFFSET = 50;
  const indicator = document.querySelector<HTMLElement>('.hero__scroll');
  if (indicator) {
    window.addEventListener('scroll', () => {
      indicator.classList.toggle('is-hidden', window.scrollY > SCROLL_HIDE_OFFSET);
    }, { passive: true });
  }
</script>

<style>
  .hero {
    height: calc(var(--vh, 1vh) * 100);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-32) var(--page-margin);
  }

  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .hero__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .hero__name {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 400;
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .hero__role {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    color: var(--color-fg-muted);
    text-transform: lowercase;
  }

  .hero__top :global(.nav) {
    padding-top: var(--space-8);
  }

  .hero__canvas {
    flex: 1;
    width: 100%;
    min-height: 0;
  }

  #bg-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__about {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .hero__scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-fg-muted);
    opacity: 0.6;
    animation: bounce 2s ease-in-out infinite;
    transition: opacity var(--duration-base) var(--ease);
  }

  .hero__scroll:global(.is-hidden) {
    opacity: 0;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(var(--space-8)); }
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--space-24) var(--page-margin);
    }

    .hero__scroll {
      padding-bottom: var(--space-24);
    }
  }
</style>
