---
interface Props {
  direction: 'down' | 'left' | 'right';
  size?: number;
}

const { direction, size = 16 } = Astro.props;
const paths = {
  down: 'M8 3L8 13M8 13L12 9M8 13L4 9',
  left: 'M13 8L3 8M3 8L7 4M3 8L7 12',
  right: 'M3 8L13 8M13 8L9 4M13 8L9 12',
};
---

<svg width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
  <path d={paths[direction]} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
