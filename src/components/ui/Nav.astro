---
import { site } from '../../lib/site';

interface Props {
  current?: 'works';
}

const { current } = Astro.props;
---

<nav class="nav" aria-label="Main">
  <a class:list={['label', 'link', { 'is-active': current === 'works' }]} href="/works/" aria-current={current === 'works' ? 'page' : undefined}>works</a>
  <a class="label link" href="/#about">about</a>
  <a class="label link" href={`mailto:${site.email}`}>contact</a>
</nav>

<style>
  .nav {
    display: flex;
    gap: var(--space-24);
  }

  .is-active {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .nav {
      gap: var(--space-16);
    }
  }
</style>
