---
export type NavSection = 'works' | 'about';

interface Props {
  current?: NavSection;
}

const { current } = Astro.props;
const items: { label: string; href: string; section?: NavSection }[] = [
  { label: 'works', href: '/works/', section: 'works' },
  { label: 'about', href: '/about/', section: 'about' },
  { label: 'contact', href: '/about/#contact' },
];
---

<nav class="nav" aria-label="Main">
  {items.map((item) => {
    const active = item.section !== undefined && item.section === current;
    return (
      <a class:list={['label', 'link', { 'is-active': active }]} href={item.href} aria-current={active ? 'page' : undefined}>{item.label}</a>
    );
  })}
</nav>

<style>
  .nav {
    display: flex;
    gap: var(--space-24);
  }

  @media (max-width: 768px) {
    .nav {
      gap: var(--space-16);
    }
  }
</style>
