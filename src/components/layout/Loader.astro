---
// ASCII loader overlay (Game-of-Life grid). Hidden once the page has loaded.
---

<div id="loader-overlay" class="loader-overlay" aria-hidden="true" role="status" aria-live="polite">
  <div class="loader-grid" role="img" aria-label="Loading page content"></div>
</div>

<script>
  import '../../scripts/loader.js';

  if (document.readyState === 'complete') {
    window.dispatchEvent(new Event('site:ready'));
  } else {
    window.addEventListener('load', () => window.dispatchEvent(new Event('site:ready')), { once: true });
  }
</script>

<style>
  .loader-overlay {
    position: fixed;
    inset: 0;
    background: var(--color-bg);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: opacity var(--duration-fast) var(--ease);
  }

  .loader-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-auto-rows: 1fr;
    gap: 6px;
    width: min(60vmin, 360px);
    height: min(60vmin, 360px);
  }

  .loader-grid :global(.loader-row) {
    display: contents;
  }

  .loader-grid :global(.loader-cell) {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: clamp(12px, 4vmin, 22px);
    line-height: 1;
    user-select: none;
  }
</style>
