---
import WorkCard from './WorkCard.astro';
import type { Work } from '../../lib/works';

interface Props {
  works: Work[];
  headingTag?: 'h2' | 'h3';
}

const { works, headingTag } = Astro.props;

// WOA mosaic: diagonal pattern of wide cards (0, 4, 8, …)
const isWide = (i: number) => i % 3 === Math.floor(i / 3) % 3;
---

<div class="works-grid">
  {works.map((work, i) => <WorkCard work={work} wide={isWide(i)} headingTag={headingTag} />)}
</div>

<style>
  .works-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-32) var(--grid-gap);
    align-items: flex-start;
  }

  @media (max-width: 768px) {
    .works-grid {
      row-gap: var(--space-24);
    }
  }
</style>
