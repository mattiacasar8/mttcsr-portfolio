---
interface Props {
  items: { key: string; value?: string; accent?: boolean }[];
}

const items = Astro.props.items.filter((item) => item.value);
---

{items.length > 0 && (
  <dl class="meta-list">
    {items.map((item) => (
      <div class="meta-list__row">
        <dt class="label label--subtle">{item.key}</dt>
        <dd class:list={[item.accent ? 'label label--accent' : 'meta-list__value']}>{item.value}</dd>
      </div>
    ))}
  </dl>
)}

<style>
  .meta-list {
    border-top: 1px solid var(--color-line);
  }

  .meta-list__row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: baseline;
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-line);
  }

  .meta-list__value {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-fg-muted);
  }

  @media (max-width: 768px) {
    .meta-list__row {
      grid-template-columns: 80px minmax(0, 1fr);
    }
  }
</style>
